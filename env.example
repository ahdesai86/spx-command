# ─────────────────────────────────────────────────────────────
# SPX COMMAND — Environment Variables Template
# ─────────────────────────────────────────────────────────────
# INSTRUCTIONS:
#   - This file is SAFE to upload to GitHub (no real keys inside)
#   - On Railway: copy each variable into the Variables tab
#   - Never create a file named .env and upload it to GitHub
# ─────────────────────────────────────────────────────────────

# Alpaca API Keys
# Get these from: app.alpaca.markets → API Keys → Generate New Key
# Make sure you are in PAPER mode before generating
ALPACA_KEY=PASTE_YOUR_KEY_ID_HERE
ALPACA_SECRET=PASTE_YOUR_SECRET_HERE
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Account Settings
ACCOUNT_SIZE=100000
RISK_PER_TRADE=0.02
MAX_DAILY_LOSS=0.06

# Strategy Settings
SPREAD_WIDTH_PTS=10
PREMIUM_STOP_PCT=0.50
ORDER_RETRY_MAX=3
ORDER_RETRY_MS=5000

# Server
PORT=3001

# Dashboard access (set a strong password in Railway)
DASHBOARD_USER=admin
DASHBOARD_PASS=PASTE_A_STRONG_DASHBOARD_PASSWORD

# Optional scoped token for a read-only dashboard/data viewer.  It can access
# dashboard, status, GEX cache (not refresh), logs, and trade/signal data only.
# Send it as the X-Read-Only-Token request header; it cannot place or close trades
# or change settings. Generate a long random value and set it only in Railway.
READONLY_TOKEN=PASTE_A_LONG_RANDOM_READ_ONLY_TOKEN

# Measurement cohort for new journal rows. Keep this unchanged while evaluating
# one strategy iteration; change it only for a deliberate new experiment.
STRATEGY_ID=orb-2dte-immediate-v1
